# ── Instagram — OFFICIAL route (Meta Graph API) ──────────────
# Only needed if you set USE_UNOFFICIAL_INSTAGRAM = False in main.py.
# Requires converting to a Business/Creator account.
IG_ACCESS_TOKEN=your_long_lived_page_access_token
IG_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# ── Instagram — UNOFFICIAL route (instagrapi) ────────────────
# Used when USE_UNOFFICIAL_INSTAGRAM = True (the default). Works with a
# personal account. Your normal Instagram login credentials.
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# ── LinkedIn ──────────────────────────────────────────────────
# Get these from linkedin.com/developers after creating an app
# with the "Share on LinkedIn" product (w_member_social scope)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=urn:li:person:your_member_id

# ── AI caption generation (optional, pick one) ───────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# ── Misc ──────────────────────────────────────────────────────
# Public URL where today's image can be fetched from (Instagram
# requires a public image_url, not a local file upload)
IMAGE_HOST_BASE_URL=https://yourdomain.com/post-images

# ── RankResume Pipeline ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
HF_TOKEN=your_huggingface_token
